<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Stylized Floating Mobile Screen (The "Mob") -->
    <!-- Screen Glass Backing -->
    <path
        android:pathData="M 37,25 h 26 a 9,9 0 0 1 9,9 v 40 a 9,9 0 0 1 -9,9 h -26 a 9,9 0 0 1 -9,-9 v -40 a 9,9 0 0 1 9,-9 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="28"
                android:startY="25"
                android:endX="72"
                android:endY="83">
                <item android:offset="0.0" android:color="#F0151C2E" />
                <item android:offset="0.5" android:color="#E60F172A" />
                <item android:offset="1.0" android:color="#F0090D16" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Screen Glass Specular Sheen (Diagonal Reflex) -->
    <path
        android:pathData="M 32,27 L 65,27 L 42,78 L 30,72 a 9,9 0 0 1 -2,-5 v -31 a 9,9 0 0 1 4,-9 z"
        android:fillColor="#0DFFFFFF" />

    <!-- Screen Neon Gradient Border -->
    <path
        android:pathData="M 37,25 h 26 a 9,9 0 0 1 9,9 v 40 a 9,9 0 0 1 -9,9 h -26 a 9,9 0 0 1 -9,-9 v -40 a 9,9 0 0 1 9,-9 z"
        android:strokeWidth="2.2"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="28"
                android:startY="25"
                android:endX="72"
                android:endY="83">
                <item android:offset="0.0" android:color="#00F0FF" />
                <item android:offset="0.5" android:color="#818CF8" />
                <item android:offset="1.0" android:color="#C084FC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Phone Top Camera/Speaker Pill -->
    <path
        android:pathData="M 46,29.5 h 8 a 1.5,1.5 0 0 1 1.5,1.5 a 1.5,1.5 0 0 1 -1.5,1.5 h -8 a 1.5,1.5 0 0 1 -1.5,-1.5 a 1.5,1.5 0 0 1 1.5,-1.5 z"
        android:fillColor="#4DFFFFFF" />

    <!-- Phone Bottom Navigation Bar Indicator -->
    <path
        android:pathData="M 44,78.5 h 12 a 1,1 0 0 1 1,1 a 1,1 0 0 1 -1,1 h -12 a 1,1 0 0 1 -1,-1 a 1,1 0 0 1 1,-1 z"
        android:fillColor="#4DFFFFFF" />

    <!-- 2. Concentric Tap Ripples (The "Tap") centered at (44, 58) -->
    <!-- Outer Ripple 3 -->
    <path
        android:pathData="M 44,37 A 21,21 0 1 0 44,79 A 21,21 0 1 0 44,37 Z"
        android:strokeWidth="1.2"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="23"
                android:startY="37"
                android:endX="65"
                android:endY="79">
                <item android:offset="0.0" android:color="#60C084FC" />
                <item android:offset="1.0" android:color="#2000F0FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Mid Ripple 2 -->
    <path
        android:pathData="M 44,44 A 14,14 0 1 0 44,72 A 14,14 0 1 0 44,44 Z"
        android:strokeWidth="1.6"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="30"
                android:startY="44"
                android:endX="58"
                android:endY="72">
                <item android:offset="0.0" android:color="#A000F0FF" />
                <item android:offset="1.0" android:color="#A0818CF8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Ripple 1 -->
    <path
        android:pathData="M 44,51 A 7,7 0 1 0 44,65 A 7,7 0 1 0 44,51 Z"
        android:strokeWidth="2.0"
        android:strokeColor="#EE00F0FF"
        android:fillColor="#1500F0FF" />

    <!-- 3. Stylus Pen 3D Soft Shadow on screen -->
    <path
        android:pathData="M 46,61 L 76,31 L 80,35 L 50,65 Z"
        android:fillColor="#55000000" />

    <!-- 4. Precision Digital Stylus Pen (The "Stylus") -->
    <!-- Stylus Main Body Barrel -->
    <path
        android:pathData="M 60.5,38.5 L 74.5,24.5 a 2.5,2.5 0 0 1 3.5,3.5 L 63.5,41.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="60"
                android:startY="24"
                android:endX="78"
                android:endY="42">
                <item android:offset="0.0" android:color="#F8FAFC" />
                <item android:offset="0.4" android:color="#CBD5E1" />
                <item android:offset="1.0" android:color="#64748B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stylus Sleek Longitudinal Specular Highlight -->
    <path
        android:pathData="M 61,38 L 74,25"
        android:strokeWidth="1.0"
        android:strokeColor="#CCFFFFFF" />

    <!-- Stylus Smart Neon Status Ring -->
    <path
        android:pathData="M 58.5,40.5 L 60.5,38.5 L 63.5,41.5 L 61.5,43.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="58"
                android:startY="38"
                android:endX="64"
                android:endY="44">
                <item android:offset="0.0" android:color="#00F0FF" />
                <item android:offset="1.0" android:color="#6366F1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stylus Lower Grip Section -->
    <path
        android:pathData="M 46.5,52.5 L 58.5,40.5 L 61.5,43.5 L 49.5,55.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="46"
                android:startY="40"
                android:endX="62"
                android:endY="56">
                <item android:offset="0.0" android:color="#E2E8F0" />
                <item android:offset="0.5" android:color="#94A3B8" />
                <item android:offset="1.0" android:color="#475569" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stylus Precision Nib Cone -->
    <path
        android:pathData="M 44,58 L 46.5,52.5 L 49.5,55.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="44"
                android:startY="52"
                android:endX="50"
                android:endY="58">
                <item android:offset="0.0" android:color="#00F0FF" />
                <item android:offset="0.6" android:color="#38BDF8" />
                <item android:offset="1.0" android:color="#FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 5. Brilliant Touch Spark / Energy Star at Contact Point (44, 58) -->
    <!-- Touch Glow Halo -->
    <path
        android:pathData="M 44,54 A 4,4 0 1 0 44,62 A 4,4 0 1 0 44,54 Z"
        android:fillColor="#8000F0FF" />

    <!-- 4-Pointed Precision Sparkle Star -->
    <path
        android:pathData="M 44,51 Q 44,58 49,58 Q 44,58 44,65 Q 44,58 39,58 Q 44,58 44,51 Z"
        android:fillColor="#FFFFFF" />

</vector>
